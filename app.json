{
  "expo": {
    "name": "Mcdowell TyreScan",
    "slug": "mcdowell-tyrescan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.mcdowellautoservices.tyrescan" },
    "android": { "package": "com.mcdowellautoservices.tyrescan" },
    "web": { "bundler": "metro" },
    "plugins": ["expo-camera", "expo-image-picker"]
  }
}
